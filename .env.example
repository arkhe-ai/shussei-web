# Base URL of the shussei-api service, no trailing slash.
#
# IMPORTANT: this must be the address the USER'S BROWSER can reach, and it is
# baked into the JavaScript bundle when `next build` runs — editing it later
# changes nothing until you rebuild.
#
#   same machine only .... http://localhost:3001
#   LAN / Tailscale / VPS . http://192.168.0.10:3001  (use your real address)
#
# Leaving it as localhost while serving the app from any other host is the most
# common setup mistake: for whoever opens the page, `localhost` is their own
# computer, so login and every API call fail. The login screen warns about it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Set to 1 to run the web client without a backend: fake session, channels,
# ephemeral chat, presence and a simulated voice room. Never enable in production.
NEXT_PUBLIC_MOCK=0
