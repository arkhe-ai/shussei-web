# Base URL of the shussei-api service, no trailing slash.
#
# IMPORTANT: this must be the address the USER'S BROWSER can reach, and it is
# baked into the JavaScript bundle when `next build` runs — editing it later
# changes nothing until you rebuild.
#
#   same machine only .... http://localhost:3001
#   LAN / Tailscale / VPS . http://192.168.0.10:3001  (use your real address)
#
# Leaving it as localhost while serving the app from any other host is the most
# common setup mistake: for whoever opens the page, `localhost` is their own
# computer, so login and every API call fail. The login screen warns about it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Set to 1 to run the web client without a backend: fake session, channels,
# ephemeral chat, presence and a simulated voice room. Never enable in production.
NEXT_PUBLIC_MOCK=0

# Only read when NEXT_PUBLIC_MOCK=1. Ambient traffic — other people posting and
# moving between voice channels on a timer — so unread badges, the notification
# blip and the typewriter can be exercised without a backend. Set to 0 for
# silence while developing.
NEXT_PUBLIC_MOCK_TRAFFIC=1

# Endereço da shussei-api a partir do SERVIDOR Next, usado só pela rota de proxy
# de arquivos (`/api/files/:id`). NEXT_PUBLIC_API_BASE_URL é o endereço que o
# NAVEGADOR precisa alcançar; dentro do Docker a API costuma estar em outro lugar.
#
# Esse proxy existe porque o cookie de sessão é SameSite=Lax: uma <img> apontando
# direto para api.exemplo.com é cross-site, não leva cookie e volta 401 — em
# produção apenas, já que em localhost cliente e API são same-site.
#
# Sem valor, o proxy reusa NEXT_PUBLIC_API_BASE_URL.
#API_INTERNAL_URL=http://api:3001
